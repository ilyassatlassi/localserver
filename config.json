{
  "servers": [
    {
      "name": "default",
      "host": "0.0.0.0",
      "ports": [
        8080,
        8081
      ],
      "default": true,
      "clientBodyLimitBytes": 10485760,
      "errorPages": {
        "400": "error_pages/400.html",
        "403": "error_pages/403.html",
        "404": "error_pages/404.html",
        "405": "error_pages/405.html",
        "413": "error_pages/413.html",
        "500": "error_pages/500.html"
      },
      "routes": [
        {
          "path": "/",
          "methods": [
            "GET"
          ],
          "root": "www",
          "index": "index.html",
          "autoIndex": false
        },
        {
          "path": "/uploads",
          "methods": [
            "GET",
            "POST",
            "DELETE"
          ],
          "root": "uploads",
          "index": "index.html",
          "autoIndex": true,
          "uploadDir": "uploads"
        },
        {
          "path": "/error_pages",
          "methods": [
            "GET"
          ],
          "root": "error_pages"
        },
        {
          "path": "/cgi",
          "methods": [
            "GET",
            "POST"
          ],
          "root": "cgi-bin",
          "cgi": {
            ".py": "/usr/bin/python3"
          }
        },
        {
          "path": "/old",
          "redirect": {
            "status": 301,
            "to": "/new"
          }
        }
      ]
    },
    {
      "name": "test",
      "host": "127.0.0.1",
      "ports": [9090],
      "default": false,
      "clientBodyLimitBytes": 1048576,
      "errorPages": {
        "400": "error_pages/400.html",
        "403": "error_pages/403.html",
        "404": "error_pages/404.html",
        "405": "error_pages/405.html",
        "413": "error_pages/413.html",
        "500": "error_pages/500.html"
      },
      "routes": [
        {
          "path": "/",
          "methods": ["GET"],
          "root": "www",
          "index": "index.html",
          "autoIndex": false
        },
        {
          "path": "/uploads",
          "methods": ["GET", "POST", "DELETE"],
          "root": "uploads",
          "index": "index.html",
          "autoIndex": true,
          "uploadDir": "uploads"
        },
        {
          "path": "/error_pages",
          "methods": ["GET"],
          "root": "error_pages",
          "autoIndex": false
        },
        {
          "path": "/cgi",
          "methods": ["GET", "POST"],
          "root": "cgi-bin",
          "cgi": {
            ".py": "/usr/bin/python3"
          }
        }
      ]
    }
  ]
}
